rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verifiedUser() { return signedIn() && request.auth.token.email_verified == true; }
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isApprovedSeller() {
      return verifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.sellerApproved == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name','phone','email','address','role','createdAt'])
        && request.resource.data.role == 'customer';
      allow update: if (isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name','phone','address','photoUrl','updatedAt']))
        || isAdmin();
      allow delete: if isAdmin();
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if isOwner(uid);
      }
    }

    match /products/{productId} {
      allow read: if resource.data.status == 'active' || isAdmin()
        || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isApprovedSeller()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['sellerId','title','categoryId','price','stock','imageUrls','status','createdAt','updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.categoryId is string
        && request.resource.data.imageUrls is list
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0;
      allow update: if isAdmin()
        || (isApprovedSeller() && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title','categoryId','price','stock','imageUrls','updatedAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.categoryId is string
          && request.resource.data.imageUrls is list
          && request.resource.data.price is number
          && request.resource.data.price > 0
          && request.resource.data.stock is int
          && request.resource.data.stock >= 0);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.sellerId == request.auth.uid
          && resource.data.status == 'pending');
    }

    match /orders/{orderId} {
      // Orders are created only by the trusted placeOrder callable function.
      allow create: if false;
      allow read: if isAdmin()
        || (signedIn() && (resource.data.customerId == request.auth.uid
          || resource.data.sellerIds.hasAny([request.auth.uid])));
      allow update: if isAdmin()
        || (isApprovedSeller()
          && resource.data.sellerIds.size() == 1
          && resource.data.sellerIds[0] == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','updatedAt','sellerNotes'])
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == 'placed'
              && request.resource.data.status in ['confirmed','cancelled'])
            || (resource.data.status == 'confirmed'
              && request.resource.data.status in ['processing','cancelled'])
            || (resource.data.status == 'processing'
              && request.resource.data.status in ['completed','cancelled'])
          ));
      allow delete: if isAdmin();
    }

    match /serviceBookings/{bookingId} {
      allow create: if verifiedUser()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.service is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.keys().hasOnly([
          'service','name','phone','address','problem','status','createdAt','customerId'
        ]);
      allow read: if isAdmin()
        || (signedIn() && (resource.data.customerId == request.auth.uid
          || resource.data.technicianId == request.auth.uid));
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.technicianId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','technicianNote','updatedAt'])
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status == 'confirmed'
              && request.resource.data.status in ['processing','cancelled'])
            || (resource.data.status == 'processing'
              && request.resource.data.status in ['completed','cancelled'])
          ));
      allow delete: if isAdmin();
    }

    match /sellerApplications/{applicationId} {
      allow create: if verifiedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.shopName is string
        && request.resource.data.shopName.size() > 1
        && request.resource.data.contact is string
        && request.resource.data.address is string
        && request.resource.data.keys().hasOnly(['userId','shopName','contact','address','status','createdAt']);
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }


    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }

    match /technicianApplications/{applicationId} {
      allow create: if verifiedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.skills is string
        && request.resource.data.keys().hasOnly([
          'userId','name','phone','address','skills','status','createdAt'
        ]);
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}